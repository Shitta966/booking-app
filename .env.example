# ==============================================================================
# FUTICK — sample environment variables
#
# Local development: copy this file to .env.local. Everything can stay empty;
#   the app then uses an embedded database in ~/.futick and generates its own secrets.
# Vercel: add each variable under Project → Settings → Environment Variables
#   (Production, and Preview if you use preview deployments). Never commit real values.
# ==============================================================================

# Public URL of the site, e.g. https://futick.vercel.app or https://futick.ng
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Database — Supabase (required in production)
# ------------------------------------------------------------------------------
# Supabase dashboard → your project → Connect → copy a pooler string, put your database password in it.
#
#   On Vercel (serverless), use the Transaction pooler, port 6543:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
#   On a long-running server (Docker, VPS), use the Session pooler, port 5432:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# The tables are created automatically on first request. They are locked away from Supabase's
# public REST API (Row Level Security on, anon/authenticated revoked), so you do not need its API keys.
DATABASE_URL=""

# Connections per server instance. Defaults to 2 on Vercel and 10 elsewhere.
# DATABASE_POOL_SIZE="2"

# ------------------------------------------------------------------------------
# Secrets (required in production) — 32+ random characters each, all different
# ------------------------------------------------------------------------------
# Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Signs login sessions. Changing it signs everyone out.
SESSION_SECRET=""
# Signs ticket QR codes. Changing it invalidates every QR code already issued — set it once.
TICKET_SIGNING_SECRET=""

# ------------------------------------------------------------------------------
# First super admin (required in production)
# ------------------------------------------------------------------------------
# Created on first start. If an account with this email exists, it is given super admin access
# and keeps its own password. Password: at least 12 characters.
FUTICK_SUPERADMIN_EMAIL=""
FUTICK_SUPERADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# Browser push notifications (optional)
# ------------------------------------------------------------------------------
# Generate a pair once with: npx web-push generate-vapid-keys
# Without them, production keeps in-app notifications and turns push off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@futick.ng"

# ------------------------------------------------------------------------------
# Development only
# ------------------------------------------------------------------------------
# Fill an empty local database with demo organisations, events and accounts (see src/lib/seed.ts).
# Ignored in production — do not set it on Vercel.
FUTICK_SEED_DEMO="true"
# Folder for the embedded development database and generated secrets (default ~/.futick).
# Keep it outside the project: the dev server watches the project folder and would reload endlessly.
# FUTICK_DATA_DIR=""
